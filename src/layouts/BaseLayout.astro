---
import Schema from "../components/Schema.astro";
import "../styles/global.css";
import { withBase } from "../utils/paths";

const {
  title = "Rainwater Directory",
  description = "Find trusted rainwater harvesting installers near you.",
  structuredData,
  canonicalUrl,
  image = "/images/og-default.webp",
  imageAlt = "Rainwater Directory — Find Certified Rainwater Harvesting Specialists & Local Legal Guides",
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? "https://rainwaterdirectory.com").replace(/\/$/, "");
const resolvedCanonical = canonicalUrl ?? (Astro.url ? `${siteUrl}${Astro.url.pathname}` : `${siteUrl}/`);
const resolvedOgImage = image.startsWith("http://") || image.startsWith("https://")
  ? image
  : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="robots" content="max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Rainwater Directory" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={resolvedCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
    />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {structuredData && <Schema data={structuredData} />}

    <!-- Plausible Analytics (Production Only) -->
    {import.meta.env.PROD && (
      <>
        <script async src="https://stats.yaogara.com/js/pa-z7RNb0bH8OYGJKn52eIPA.js"></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen bg-neutral-50 font-sans text-slate-900">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href={withBase("/")} class="text-xl font-semibold text-primary-600">
          Rainwater Directory
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <a class="transition hover:text-primary-600" href={withBase("/states")}>
            States
          </a>
          <a class="transition hover:text-primary-600" href={withBase("/installers")}>
            Installers
          </a>
          <a
            class="transition hover:text-primary-600"
            href={withBase("/blog")}
          >
            Blog
          </a>
          <a
            class="transition hover:text-primary-600"
            href={withBase("/about")}
          >
            About
          </a>
          <a class="rounded-full bg-primary-600 px-4 py-2 text-white transition hover:bg-primary-700" href={withBase("/#cta")}>
            Get Listed
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto min-h-[70vh] max-w-6xl px-4 py-12 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>&copy; {new Date().getFullYear()} Rainwater Directory. All rights reserved.</p>
        <div class="flex flex-wrap gap-4">
          <a
            class="transition hover:text-primary-600"
            href={withBase("/about")}
          >
            About
          </a>
          <a
            class="transition hover:text-primary-600"
            href={withBase("/about#editorial-standards")}
          >
            Editorial Standards
          </a>
          <a
            class="transition hover:text-primary-600"
            href={withBase("/blog/how-to-choose-an-installer")}
          >
            Learn
          </a>
          <a class="transition hover:text-primary-600" href={withBase("/#faq")}>
            FAQ
          </a>
          <a class="transition hover:text-primary-600" href={withBase("/states")}>
            Browse States
          </a>
          <a class="transition hover:text-primary-600" href={withBase("/installers")}>
            Find Installers
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
