---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../utils/paths";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find((entry) => entry.slug === slug);

if (!post) {
  throw new Response("Blog post not found", { status: 404 });
}

const { Content } = await post.render();

const canonicalSite = (Astro.site?.toString() ?? "https://rainwaterdirectory.com").replace(/\/$/, "");
const postUrl = `${canonicalSite}/blog/${post.slug}`;

const featuredImage = post.data.image ?? "/images/og-default.webp";
const featuredImageAlt = post.data.imageAlt ?? post.data.title;
const absoluteImageUrl = featuredImage.startsWith("http")
  ? featuredImage
  : `${canonicalSite}${featuredImage.startsWith("/") ? "" : "/"}${featuredImage}`;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${canonicalSite}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: postUrl,
    },
  ],
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate ?? post.data.pubDate,
  image: {
    "@type": "ImageObject",
    url: absoluteImageUrl,
    width: 1200,
    height: 675,
  },
  author: {
    "@type": "Person",
    name: post.data.author ?? "Rainwater Directory Team",
  },
  url: postUrl,
  publisher: {
    "@type": "Organization",
    name: "Rainwater Directory",
    logo: {
      "@type": "ImageObject",
      url: `${canonicalSite}/favicon.svg`,
    },
  },
};

const structuredData = [blogSchema, breadcrumbData];
---
<BaseLayout
  title={`${post.data.title} | Rainwater Directory`}
  description={post.data.description}
  canonicalUrl={postUrl}
  structuredData={structuredData}
  image={featuredImage}
  imageAlt={featuredImageAlt}
>
  <nav aria-label="Breadcrumb" class="text-sm text-slate-600">
    <ol class="flex items-center gap-2">
      <li>
        <a class="text-primary-600 hover:text-primary-700" href={withBase("/")}>
          Home
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-500">Blog</li>
    </ol>
  </nav>

  <article class="prose prose-slate mt-8 max-w-none prose-headings:font-semibold prose-a:text-primary-600">
    <header>
      <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-slate-500">
        <span class="rounded-full bg-primary-50 px-3 py-1 font-semibold uppercase tracking-wide text-primary-700">
          Insights & Guides
        </span>
        <a
          href={withBase("/about#editorial-standards")}
          class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-amber-800 hover:bg-amber-100 transition"
          title="Review our sourcing and correction standards"
        >
          Source review in progress
        </a>
      </div>
      <h1 class="mt-3 text-3xl font-semibold text-slate-900">{post.data.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-4 text-sm text-slate-500">
        <p>By <span class="font-medium text-slate-800">{post.data.author ?? "Rainwater Directory Technical Team"}</span></p>
        <span aria-hidden="true">&bull;</span>
        <p>Updated {new Date(post.data.pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p>
      </div>
    </header>

    {post.data.image && (
      <figure class="not-prose my-8">
        <img
          src={withBase(post.data.image)}
          alt={featuredImageAlt}
          width="1200"
          height="675"
          fetchpriority="high"
          decoding="async"
          class="aspect-video w-full rounded-2xl border border-slate-200 object-cover shadow-sm"
        />
        {post.data.imageAlt && (
          <figcaption class="mt-2 text-center text-xs text-slate-500">
            {post.data.imageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mt-6">
      <Content />
    </div>

    <footer class="not-prose mt-12 border-t border-slate-200 pt-8">
      <div class="rounded-xl border border-slate-200 bg-slate-50/75 p-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="rounded-full bg-primary-100 p-3 text-primary-700">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900">
              Editorial Integrity & Sourcing Transparency
            </h3>
            <p class="mt-1 text-sm text-slate-600">
              This educational guide is being migrated to claim-level sourcing. Verify product specifications, codes, incentives, and professional requirements with the linked primary source and the authority serving your project before acting. Rainwater Directory does not accept paid rankings.
            </p>
            <div class="mt-3 flex flex-wrap gap-4 text-xs font-medium">
              <a href={withBase("/about#editorial-standards")} class="text-primary-600 hover:text-primary-700 underline">
                Read our Editorial Standards &rarr;
              </a>
              <a href={withBase("/about#contractor-verification")} class="text-primary-600 hover:text-primary-700 underline">
                How We Vet Contractors &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
