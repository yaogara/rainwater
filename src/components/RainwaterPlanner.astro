---
import rainfall from "../data/rainfall.json";
import { withBase } from "../utils/paths";

const {
  compact = false,
  initialState = "Texas",
  initialRainfall,
  region = initialState,
} = Astro.props;

const states = [...rainfall.states].sort((a, b) => a.name.localeCompare(b.name));
const selectedRainfall = initialRainfall ?? states.find((item) => item.name === initialState)?.inches ?? "";
const rainfallByState = Object.fromEntries(states.map((item) => [item.name, item.inches]));
---

<section class:list={["rounded-3xl border border-slate-200 bg-white shadow-sm", compact ? "mt-8 p-6" : "p-6 sm:p-8"]} data-rainwater-planner>
  <div class="border-b border-slate-100 pb-5">
    <p class="text-xs font-bold uppercase tracking-wider text-primary-600">Rainwater planning estimate</p>
    <h2 class="mt-1 text-2xl font-bold text-slate-900">Collection potential and storage target</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-600">
      Estimate annual roof collection separately from the storage needed to cover your chosen daily demand and reserve period.
    </p>
  </div>

  <form class="mt-6 grid gap-5 md:grid-cols-2" data-planner-form>
    <label class="text-sm font-semibold text-slate-800">
      Roof catchment area (sq ft)
      <input class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="roofArea" type="number" min="1" max="1000000" step="1" value="2000" required />
    </label>

    <label class="text-sm font-semibold text-slate-800">
      State or territory
      <select class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="state">
        {states.map((item) => <option value={item.name} selected={item.name === initialState}>{item.name}</option>)}
        <option value="manual">Use manual rainfall</option>
      </select>
    </label>

    <label class="text-sm font-semibold text-slate-800">
      Annual rainfall (inches)
      <input class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="rainfall" type="number" min="0.1" max="250" step="0.1" value={selectedRainfall} required />
      <span class="mt-1 block text-xs font-normal text-slate-500">Statewide historical averages are starting estimates. Enter a verified local value when available.</span>
    </label>

    <label class="text-sm font-semibold text-slate-800">
      Runoff efficiency
      <select class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="efficiency">
        <option value="0.8">80% — conservative</option>
        <option value="0.85">85% — typical planning</option>
        <option value="0.9" selected>90% — smooth, efficient roof</option>
      </select>
    </label>

    <label class="text-sm font-semibold text-slate-800">
      Intended use
      <select class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="intendedUse">
        <option>Garden irrigation</option>
        <option>Landscape irrigation</option>
        <option>Toilets and laundry</option>
        <option>Whole-house supply</option>
        <option>Emergency reserve</option>
      </select>
    </label>

    <label class="text-sm font-semibold text-slate-800">
      Planned daily demand (gallons)
      <input class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="dailyDemand" type="number" min="0.1" max="100000" step="0.1" value="50" required />
    </label>

    <label class="text-sm font-semibold text-slate-800">
      Desired reserve (days)
      <input class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2" name="reserveDays" type="number" min="1" max="365" step="1" value="30" required />
    </label>

    <div class="flex items-end">
      <button class="w-full rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700" type="submit">
        Calculate my plan
      </button>
    </div>
  </form>

  <div class="mt-7 hidden rounded-2xl bg-slate-50 p-5" data-planner-results aria-live="polite">
    <div class="grid gap-4 sm:grid-cols-3">
      <div><p class="text-xs font-semibold uppercase text-slate-500">Annual collection</p><p class="mt-1 text-2xl font-bold text-primary-700"><span data-result="annual">0</span> gal</p></div>
      <div><p class="text-xs font-semibold uppercase text-slate-500">Average monthly collection</p><p class="mt-1 text-2xl font-bold text-slate-900"><span data-result="monthly">0</span> gal</p></div>
      <div><p class="text-xs font-semibold uppercase text-slate-500">Storage target</p><p class="mt-1 text-2xl font-bold text-slate-900"><span data-result="storage">0</span> gal</p></div>
    </div>
    <div class="mt-5 border-t border-slate-200 pt-4 text-sm text-slate-700" data-result="brief"></div>
    <div class="mt-5 flex flex-wrap gap-3 print:hidden">
      <button class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700" type="button" data-print-plan>Print project brief</button>
      <a class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white" href={withBase("/installers")} data-event="calculator_installer_next_step" data-event-region={region}>Find an installer</a>
      <a class="rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm font-semibold text-primary-700" href={withBase("/blog/top-10-water-storage-tanks-100-to-5000-gallons")} data-event="equipment_guide_visit" data-event-region={region}>Choose equipment</a>
    </div>
  </div>

  <p class="mt-5 text-xs leading-relaxed text-slate-500">
    Collection formula: roof area × annual rainfall × 0.6233 × runoff efficiency. Storage target: daily demand × reserve days. This screening estimate does not model monthly droughts, tank overflow, local roof geometry, water quality, permits, or structural requirements. Rainfall source: <a class="underline" href={rainfall.metadata.source_url} rel="noopener" target="_blank">{rainfall.metadata.source}</a>, {rainfall.metadata.period}; verified {rainfall.metadata.verified_at}.
  </p>
</section>

<script define:vars={{ rainfallByState }}>
  const calculatePlan = ({ roofAreaSqFt, annualRainfallInches, runoffEfficiency, dailyDemandGallons, reserveDays }) => {
    const annualCollectionGallons = Math.round(roofAreaSqFt * annualRainfallInches * 0.6233 * runoffEfficiency);
    return {
      annualCollectionGallons,
      averageMonthlyCollectionGallons: Math.round(annualCollectionGallons / 12),
      storageTargetGallons: Math.round(dailyDemandGallons * reserveDays),
    };
  };
  for (const root of document.querySelectorAll("[data-rainwater-planner]")) {
    if (root.dataset.initialized === "true") continue;
    root.dataset.initialized = "true";
    const form = root.querySelector("[data-planner-form]");
    const state = form?.elements.namedItem("state");
    const rainfallInput = form?.elements.namedItem("rainfall");
    const results = root.querySelector("[data-planner-results]");

    state?.addEventListener("change", () => {
      if (state.value !== "manual" && rainfallByState[state.value]) rainfallInput.value = rainfallByState[state.value];
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const roofArea = Number(data.get("roofArea"));
      const annualRainfall = Number(data.get("rainfall"));
      const efficiency = Number(data.get("efficiency"));
      const dailyDemand = Number(data.get("dailyDemand"));
      const reserveDays = Number(data.get("reserveDays"));
      const plan = calculatePlan({ roofAreaSqFt: roofArea, annualRainfallInches: annualRainfall, runoffEfficiency: efficiency, dailyDemandGallons: dailyDemand, reserveDays });
      const annual = plan.annualCollectionGallons;
      const storage = plan.storageTargetGallons;
      const formatter = new Intl.NumberFormat("en-US");
      root.querySelector('[data-result="annual"]').textContent = formatter.format(annual);
      root.querySelector('[data-result="monthly"]').textContent = formatter.format(plan.averageMonthlyCollectionGallons);
      root.querySelector('[data-result="storage"]').textContent = formatter.format(storage);
      root.querySelector('[data-result="brief"]').textContent = `Planning brief: ${formatter.format(roofArea)} sq ft roof, ${annualRainfall} inches annual rainfall, ${Math.round(efficiency * 100)}% efficiency, ${data.get("intendedUse")}, ${formatter.format(dailyDemand)} gallons/day, and ${reserveDays} reserve days. Annual collection potential is ${formatter.format(annual)} gallons. The demand-based storage target is ${formatter.format(storage)} gallons.`;
      results.classList.remove("hidden");
      if (typeof window.plausible === "function") window.plausible("calculator_completion", { props: { page: window.location.pathname, region: state.value } });
    });

    root.querySelector("[data-print-plan]")?.addEventListener("click", () => {
      if (typeof window.plausible === "function") window.plausible("calculator_print", { props: { page: window.location.pathname, region: state?.value || "manual" } });
      window.print();
    });
  }
</script>
