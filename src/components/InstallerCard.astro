---
import { withBase } from "../utils/paths";

const { installer } = Astro.props;
const rating = typeof installer.rating === "number" ? installer.rating : undefined;
const reviewsCount = typeof installer.reviews_count === "number" ? installer.reviews_count : undefined;
const fullStars = rating ? Math.round(rating) : 0;
const services = installer.services ?? [];
const certifications = installer.certifications;
const serviceArea = installer.service_area ?? [];
const address = installer.address;
---
<article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary-300 hover:shadow-md">
  <div>
    <header class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-lg font-bold text-slate-900 leading-snug">{installer.name}</h3>
        {address && (
          <p class="mt-1 flex items-center gap-1 text-xs text-slate-500">
            <span class="text-slate-400" aria-hidden="true">📍</span>
            <span>{address}</span>
          </p>
        )}
      </div>
      {installer.verified && (
        <span class="shrink-0 inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 border border-emerald-200">
          <span aria-hidden="true">✓</span>
          Verified
        </span>
      )}
    </header>

    {rating && (
      <div class="mt-2.5 flex items-center gap-2 text-sm text-slate-600">
        <span class="flex gap-0.5 text-amber-500" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, index) => (
            <span class={index < fullStars ? "text-amber-500" : "text-slate-200"}>★</span>
          ))}
        </span>
        <span class="font-semibold text-slate-800">{rating.toFixed(1)}</span>
        {reviewsCount && (
          <span class="text-xs text-slate-500">({reviewsCount} {reviewsCount === 1 ? "review" : "reviews"})</span>
        )}
      </div>
    )}

    {certifications && (
      <div class="mt-3.5 rounded-lg border border-primary-200 bg-primary-50/70 p-2.5 text-xs text-primary-950">
        <div class="flex items-center gap-1.5 font-semibold text-primary-800">
          <svg class="h-4 w-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Verified Credentials &amp; Standards:</span>
        </div>
        <p class="mt-1 text-slate-700 leading-relaxed">{certifications}</p>
      </div>
    )}

    {services.length > 0 && (
      <div class="mt-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Core Services</h4>
        <div class="mt-1.5 flex flex-wrap gap-1.5">
          {services.slice(0, 5).map((service) => (
            <span class="inline-block rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700">
              {service}
            </span>
          ))}
          {services.length > 5 && (
            <span class="inline-block rounded-md bg-slate-50 px-2 py-0.5 text-xs text-slate-500">
              +{services.length - 5} more
            </span>
          )}
        </div>
      </div>
    )}

    {serviceArea.length > 0 && (
      <p class="mt-3 text-xs text-slate-500">
        <span class="font-medium text-slate-600">Service Area:</span> {serviceArea.join(", ")}
      </p>
    )}
  </div>

  <div class="mt-5 pt-4 border-t border-slate-100">
    <div class="flex flex-wrap items-center gap-3">
      {installer.phone && (
        <a
          class="inline-flex items-center gap-1.5 rounded-lg bg-primary-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-primary-700 transition"
          href={`tel:${installer.phone}`}
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call {installer.phone}
        </a>
      )}
      {installer.website && (
        <a
          class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition"
          href={installer.website}
          rel="noopener"
          target="_blank"
        >
          Visit Website
          <span class="text-slate-400" aria-hidden="true">↗</span>
        </a>
      )}
    </div>

    <div class="mt-3 pt-2 text-xs text-slate-500">
      Need guidance? Read our <a class="font-medium text-primary-600 hover:underline" href={withBase("/blog/how-to-choose-an-installer")}>10-question contractor vetting checklist &rarr;</a>
    </div>
  </div>
</article>
